generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String?       @unique
  passwordHash String?
  role         String        @default("PLAYER")
  balance      Int           @default(10000)
  blockedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions  Session[]
  ledger    WalletEntry[]
  ratings   Rating[]
  seasons   Season[]
  adminLogs AdminLog[]
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime

  @@index([userId])
}

model WalletEntry {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  amount         Int
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Participant {
  id           String    @id
  sport        String
  name         String
  groupName    String
  baseRating   Int
  logoUrl      String?
  attributes   Json
  ratings      Rating[]
  homeFixtures Fixture[] @relation("Home")
  awayFixtures Fixture[] @relation("Away")

  @@unique([sport, name])
  @@index([sport, groupName])
}

model Competition {
  id       String    @id
  sport    String
  name     String
  tier     String
  format   String
  metadata Json
  fixtures Fixture[]

  @@unique([sport, name])
}

model Rating {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  participantId     String
  participant       Participant @relation(fields: [participantId], references: [id])
  powerRating       Float
  recentForm        Json
  fatigue           Float       @default(0)
  streak            Int         @default(0)
  effectiveStrength Float
  updatedAt         DateTime    @updatedAt

  @@unique([userId, participantId])
}

model Season {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  number     Int
  startedAt  DateTime
  endsAt     DateTime
  secretSeed String
  seedCommit String
  status     String    @default("ACTIVE")
  simulationState String  @default("READY")
  virtualNowMs BigInt   @default(0)
  simulationSpeed Int    @default(1)
  resumedAt   DateTime?
  pausedAt    DateTime?
  finishedAt  DateTime?
  fixtures   Fixture[]

  @@unique([userId, number])
  @@index([userId, status])
}

model AdminLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  metadata  Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Fixture {
  id                String      @id
  seasonId          String
  season            Season      @relation(fields: [seasonId], references: [id])
  competitionId     String
  competition       Competition @relation(fields: [competitionId], references: [id])
  homeId            String
  home              Participant @relation("Home", fields: [homeId], references: [id])
  awayId            String
  away              Participant @relation("Away", fields: [awayId], references: [id])
  round             Int
  kickoffAt         DateTime
  endsAt            DateTime
  seedCommit        String
  ratingSnapshot    Json
  cancellationReason String?
  liveTimeline      Json?
  finalHomeScore    Int?
  finalAwayScore    Int?
  resultCommittedAt DateTime?

  @@unique([seasonId, competitionId, round, homeId])
  @@index([seasonId, kickoffAt])
  @@index([homeId, kickoffAt])
  @@index([awayId, kickoffAt])
}
